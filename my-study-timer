
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#07110f">
<title>وقتي | ركّز على هدفك</title>
<style>
:root{
  --bg:#07110f;--panel:#101e1b;--panel2:#142722;
  --line:#23443a;--green:#a3ffcb;--neon:#39ff9b;
  --text:#f1fff7;--muted:#9ab8aa;--red:#ff8585;
  --shadow:0 0 35px #39ff9b0c;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;min-height:100vh;color:var(--text);
  background:
    radial-gradient(ellipse at 15% 5%,#124b3540,transparent 40%),
    radial-gradient(ellipse at 90% 45%,#0d483130,transparent 38%),
    var(--bg);
  font-family:system-ui,-apple-system,"Segoe UI",sans-serif;
}
button,input{font:inherit}
button{cursor:pointer;transition:transform .2s,background .2s,border-color .2s}
button:active{transform:scale(.97)}
button:focus-visible,input:focus-visible{outline:2px solid var(--neon);outline-offset:3px}
button:disabled{opacity:.45;cursor:not-allowed}
.app{max-width:1100px;margin:auto;padding:24px 17px 35px}
header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:27px}
.brand{display:flex;align-items:center;gap:12px}
.logo{
  display:grid;place-items:center;width:47px;height:47px;border-radius:16px;
  color:#062216;background:linear-gradient(145deg,#d0ffe4,var(--neon));
  font-size:27px;font-weight:900;box-shadow:0 0 24px #39ff9b32
}
.brand h1{font-size:24px;margin:0;letter-spacing:-.7px}
.brand p{margin:3px 0 0;color:var(--muted);font-size:12px}
.top-actions{display:flex;gap:8px;flex-wrap:wrap}
.btn{
  border:1px solid var(--line);background:#13241e;color:var(--text);
  padding:10px 13px;border-radius:12px;font-size:13px
}
.btn:hover{border-color:var(--neon);background:#1a3328}
.primary{
  border:1px solid #b5ffda;background:linear-gradient(135deg,#baffd8,#39ff9b);
  color:#062316;font-weight:850;padding:13px 23px;border-radius:14px;
  box-shadow:0 0 22px #39ff9b25
}
.primary:hover{box-shadow:0 0 30px #39ff9b50;transform:translateY(-1px)}
.layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:17px}
.panel{
  min-width:0;background:linear-gradient(145deg,#14251fef,#0e1b18f5);
  border:1px solid var(--line);border-radius:23px;padding:23px;
  box-shadow:var(--shadow);position:relative;overflow:hidden;
  animation:appear .55s ease both
}
.panel:before{
  content:"";position:absolute;top:0;right:15%;width:45%;height:1px;
  background:linear-gradient(90deg,transparent,var(--neon),transparent);opacity:.5
}
.panel h2{font-size:17px;margin:0 0 18px}
.eyebrow{font-size:11px;color:var(--neon);letter-spacing:1.5px;font-weight:800}
.timer-panel{text-align:center}
.mode-row{display:flex;gap:8px;margin:19px 0 7px}
.mode{
  flex:1;min-width:0;padding:11px 5px;border:1px solid var(--line);
  border-radius:12px;background:#0c1915;color:var(--muted);font-size:12px
}
.mode.active{
  color:var(--neon);border-color:#39ff9b90;background:#39ff9b12;
  box-shadow:inset 0 0 18px #39ff9b0b
}
.ring-wrap{width:min(290px,100%);aspect-ratio:1;margin:9px auto 8px;position:relative;display:grid;place-items:center}
.ring-svg{width:100%;height:100%;transform:rotate(-90deg);overflow:visible}
.ring-bg{fill:none;stroke:#203a30;stroke-width:7}
.ring-progress{
  fill:none;stroke:var(--neon);stroke-width:7;stroke-linecap:round;
  stroke-dasharray:565.49;stroke-dashoffset:0;
  filter:drop-shadow(0 0 6px #39ff9b88);
  transition:stroke-dashoffset .3s linear,stroke .3s
}
.ring-core{
  position:absolute;inset:14%;border-radius:50%;display:flex;
  flex-direction:column;justify-content:center;align-items:center;
  background:radial-gradient(circle,#16382a55,transparent 72%)
}
.clock{font-size:clamp(49px,8vw,67px);font-weight:850;letter-spacing:-2px;direction:ltr;line-height:1.2;font-variant-numeric:tabular-nums}
.phase{color:var(--muted);font-size:13px;margin-top:9px}
.focus-label{color:var(--neon);font-size:11px;margin-top:17px;letter-spacing:1px}
.timer-actions{display:flex;justify-content:center;align-items:center;gap:9px;flex-wrap:wrap;margin-top:9px}
.icon-btn{width:45px;height:45px;border-radius:14px;border:1px solid var(--line);background:#13251e;color:var(--text);font-size:18px}
.icon-btn:hover{border-color:var(--neon);color:var(--neon)}
#startBtn{min-width:135px}
.status{min-height:23px;margin:17px 0 0;color:var(--green);font-size:13px}
.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}
.stat{padding:15px 5px;border:1px solid #254439;background:#0c1915;border-radius:15px;text-align:center}
.stat-icon{font-size:17px}
.stat strong{display:block;font-size:25px;color:var(--neon);margin:6px 0 2px;font-variant-numeric:tabular-nums}
.stat span{font-size:11px;color:var(--muted)}
.goal{margin-top:19px}
.goal-head{display:flex;justify-content:space-between;gap:10px;font-size:12px;color:var(--muted);margin-bottom:10px}
.bar{height:7px;border-radius:20px;background:#233b30;overflow:hidden}
.bar div{height:100%;width:0;background:linear-gradient(90deg,#39ff9b,#c3ffdf);border-radius:20px;transition:width .35s}
.settings{margin-top:24px;padding-top:20px;border-top:1px solid var(--line)}
.settings h3{font-size:14px;margin:0 0 14px}
.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
label{display:block;font-size:12px;color:var(--muted)}
input[type=number],input[type=text]{
  width:100%;min-width:0;background:#091510;color:var(--text);
  border:1px solid #294438;border-radius:11px;padding:11px;margin-top:7px
}
input:focus{border-color:var(--neon)}
.wide{width:100%;margin-top:13px}
.side{display:grid;align-content:start;gap:17px}
.task-form{display:flex;gap:8px;margin-bottom:13px}
.task-form input{margin:0;flex:1;width:0}
.task-form button{padding:10px 13px;white-space:nowrap}
.task-list{list-style:none;padding:0;margin:0;display:grid;gap:8px}
.task{
  display:flex;align-items:center;gap:10px;min-width:0;
  padding:11px;background:#0b1813;border:1px solid #20392e;border-radius:12px
}
.task input{width:18px;height:18px;margin:0;accent-color:var(--neon);flex-shrink:0}
.task-name{flex:1;min-width:0;overflow-wrap:anywhere;font-size:13px}
.task.done .task-name{text-decoration:line-through;color:#789386}
.del{border:0;background:transparent;color:#a5b8ad;padding:5px 7px;border-radius:8px}
.del:hover{color:var(--red);background:#ff858512}
.empty{text-align:center;padding:22px 8px;color:var(--muted);font-size:13px;line-height:1.9}
.task-foot{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:13px;color:var(--muted);font-size:12px}
.text-btn{border:0;background:transparent;color:var(--neon);font-size:12px;padding:6px}
.tip{display:flex;gap:12px;align-items:flex-start}
.tip-icon{font-size:23px}
.tip p{font-size:13px;color:var(--muted);line-height:1.9;margin:5px 0 0}
.tip strong{color:var(--text)}
.footer{text-align:center;color:#6d8c7d;font-size:11px;padding:25px 0 0}
.hidden{display:none!important}
@keyframes appear{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:translateY(0)}}
@keyframes glow{0%,100%{filter:drop-shadow(0 0 5px #39ff9b55)}50%{filter:drop-shadow(0 0 12px #39ff9baa)}}
.ring-progress.running{animation:glow 3s ease-in-out infinite}
@media(min-width:721px){
  .timer-panel{padding:27px}
  .side .panel:nth-child(2){animation-delay:.1s}
}
@media(max-width:720px){
  .app{padding:16px 12px 27px}
  .layout{grid-template-columns:1fr}
  .panel{padding:19px;border-radius:20px}
  .brand h1{font-size:21px}
  .ring-wrap{width:min(275px,85%)}
}
@media(max-width:380px){
  .brand p{font-size:10px}
  .top-actions .btn{padding:9px;font-size:11px}
  .clock{font-size:49px}
  .mode{font-size:10px}
  .stats{gap:5px}
  .stat strong{font-size:21px}
  .stat span{font-size:10px}
}
@media(prefers-reduced-motion:reduce){
  *,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
}
</style>
</head>
<body>
<div class="app">
<header>
  <div class="brand">
    <div class="logo">و</div>
    <div>
      <h1>وقتي<span style="color:var(--neon)">.</span></h1>
      <p>وقتك أغلى من إنك تضيّعه ✦</p>
    </div>
  </div>
  <div class="top-actions">
    <button class="btn" id="soundBtn" type="button">🔔 الصوت يعمل</button>
  </div>
</header>

<main class="layout">
<section class="panel timer-panel">
  <div class="eyebrow">FOCUS SPACE / 01</div>
  <h2 style="margin-top:8px">مساحة التركيز</h2>

  <div class="mode-row">
    <button class="mode active" data-mode="work">📚 مذاكرة</button>
    <button class="mode" data-mode="short">☕ راحة قصيرة</button>
    <button class="mode" data-mode="long">🌿 راحة طويلة</button>
  </div>

  <div class="ring-wrap">
    <svg class="ring-svg" viewBox="0 0 200 200" aria-hidden="true">
      <circle class="ring-bg" cx="100" cy="100" r="90"/>
      <circle class="ring-progress" id="ring" cx="100" cy="100" r="90"/>
    </svg>
    <div class="ring-core">
      <div class="clock" id="clock" role="timer" aria-label="الوقت المتبقي">25:00</div>
      <div class="phase" id="phase">جاهز لجلسة جديدة؟</div>
      <div class="focus-label" id="focusLabel">✦ وقتك ليك ✦</div>
    </div>
  </div>

  <div class="timer-actions">
    <button class="primary" id="startBtn" type="button">▶ ابدأ التركيز</button>
    <button class="icon-btn" id="resetBtn" type="button" aria-label="إعادة ضبط" title="إعادة ضبط">↺</button>
    <button class="icon-btn" id="skipBtn" type="button" aria-label="المرحلة التالية" title="المرحلة التالية">⏭</button>
  </div>
  <div class="status" id="status" aria-live="polite">ابدأ بخطوة صغيرة، وهتوصل 💚</div>

  <div class="settings">
    <h3>⚙ إعدادات الجلسات</h3>
    <div class="settings-grid">
      <label>مدة المذاكرة (دقيقة)
        <input id="workLen" type="number" min="1" max="180" value="25">
      </label>
      <label>الراحة القصيرة
        <input id="shortLen" type="number" min="1" max="60" value="5">
      </label>
      <label>الراحة الطويلة
        <input id="longLen" type="number" min="1" max="90" value="15">
      </label>
      <label>جلسات قبل الراحة الطويلة
        <input id="cycleLen" type="number" min="2" max="8" value="4">
      </label>
      <label style="grid-column:1/-1">هدف التركيز اليومي (دقيقة)
        <input id="goalLen" type="number" min="15" max="1440" step="15" value="120">
      </label>
    </div>
    <button class="btn wide" id="applyBtn" type="button">حفظ الإعدادات ✓</button>
  </div>
</section>

<div class="side">
<section class="panel">
  <div class="eyebrow">YOUR PROGRESS / 02</div>
  <h2 style="margin-top:8px">إنجازك النهارده</h2>
  <div class="stats">
    <div class="stat">
      <div class="stat-icon">🎯</div>
      <strong id="sessions">0</strong>
      <span>جلسات مكتملة</span>
    </div>
    <div class="stat">
      <div class="stat-icon">⌛</div>
      <strong id="minutes">0</strong>
      <span>دقيقة تركيز</span>
    </div>
    <div class="stat">
      <div class="stat-icon">⚡</div>
      <strong id="percent">0%</strong>
      <span>المهام المنجزة</span>
    </div>
  </div>
  <div class="goal">
    <div class="goal-head"><span>هدفك اليومي</span><span id="goalText">0 / 120 دقيقة</span></div>
    <div class="bar"><div id="goalBar"></div></div>
  </div>
  <button class="text-btn" id="clearStats" type="button" style="margin-top:13px">إعادة ضبط إحصائيات اليوم</button>
</section>

<section class="panel">
  <div class="eyebrow">YOUR CHECKLIST / 03</div>
  <h2 style="margin-top:8px">قائمة مهامك 📝</h2>
  <form class="task-form" id="taskForm">
    <input id="taskInput" type="text" maxlength="120" placeholder="اكتب درس أو مهمة..." required>
    <button class="primary" type="submit">+ إضافة</button>
  </form>
  <ul class="task-list" id="taskList"></ul>
  <div class="empty" id="empty">لسه مفيش مهام 👀<br>اكتب أول مهمة وابدأ إنجازها!</div>
  <div class="task-foot">
    <span id="taskCount">0 مهام</span>
    <button class="text-btn" id="clearDone" type="button">حذف المكتمل</button>
  </div>
</section>

<section class="panel">
  <div class="tip">
    <div class="tip-icon">💡</div>
    <div>
      <strong>نصيحة وقتي</strong>
      <p id="tipText">ابعد موبايلك، وحدد مهمة واحدة، وابدأ. مش لازم تكون متحمس عشان تبدأ.</p>
      <button class="text-btn" id="newTip" type="button">نصيحة تانية ↻</button>
    </div>
  </div>
</section>
</div>
</main>
<div class="footer">صُنع عشان يساعدك تركز · وقتي ©</div>
</div>

<script>
(() => {
'use strict';

const $ = id => document.getElementById(id);
const KEY = {
  settings:'waqti_pro_settings_v2',
  tasks:'waqti_pro_tasks_v2',
  stats:'waqti_pro_stats_v2'
};
const defaults = {work:25,short:5,long:15,cycle:4,goal:120};
const circumference = 2 * Math.PI * 90;
let settings = {...defaults};
let mode = 'work';
let remaining = 25 * 60;
let interval = null;
let deadline = null;
let sound = true;
let cycles = 0;
let audioContext = null;
let tasks = read(KEY.tasks,[]);
let stats = read(KEY.stats,{date:today(),sessions:0,minutes:0});

function read(key,fallback){
  try{
    const raw=localStorage.getItem(key);
    return raw===null?fallback:JSON.parse(raw);
  }catch(e){return fallback}
}
function save(key,value){
  try{localStorage.setItem(key,JSON.stringify(value))}
  catch(e){setStatus('تعذر الحفظ في المتصفح. تأكد من مساحة التخزين.')}
}
function today(){
  const d=new Date();
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}
function checkDay(){
  if(stats.date!==today())stats={date:today(),sessions:0,minutes:0};
}
function duration(m=mode){return settings[m]*60}
function fmt(n){return String(n).padStart(2,'0')}
function formatTime(sec){
  sec=Math.max(0,Math.ceil(sec));
  return fmt(Math.floor(sec/60))+':'+fmt(sec%60);
}
function setStatus(message){$('status').textContent=message}
function modeName(m){
  return m==='work'?'المذاكرة':m==='short'?'الراحة القصيرة':'الراحة الطويلة';
}
function renderTimer(){
  $('clock').textContent=formatTime(remaining);
  $('clock').setAttribute('aria-label','الوقت المتبقي '+formatTime(remaining));
  $('phase').textContent=mode==='work'?'وقت التركيز 📚':mode==='short'?'استراحة قصيرة ☕':'استراحة طويلة 🌿';
  const pct=Math.max(0,Math.min(1,remaining/duration()));
  $('ring').style.strokeDashoffset=String(circumference*(1-pct));
  $('ring').classList.toggle('running',!!interval);
  document.querySelectorAll('[data-mode]').forEach(b=>{
    b.classList.toggle('active',b.dataset.mode===mode);
    b.setAttribute('aria-pressed',String(b.dataset.mode===mode));
  });
  $('startBtn').textContent=interval?'⏸ إيقاف مؤقت':remaining<duration()?'▶ استكمال':'▶ ابدأ التركيز';
  document.title=formatTime(remaining)+' | وقتي';
}
function stop(){
  if(interval!==null)clearInterval(interval);
  interval=null;deadline=null;
}
function start(){
  if(interval!==null)return;
  if(remaining<=0)remaining=duration();
  deadline=Date.now()+remaining*1000;
  interval=setInterval(update,200);
  renderTimer();
  setStatus(mode==='work'?'ركز في هدف واحد، وسيب الباقي بعدين 💚':'استمتع براحتك، وارجع بنشاط 🌿');
}
function pause(){
  if(interval===null)return;
  remaining=Math.max(0,Math.ceil((deadline-Date.now())/1000));
  stop();renderTimer();setStatus('اتوقف مؤقتًا — كمل لما تكون جاهز.');
}
function update(){
  remaining=Math.max(0,Math.ceil((deadline-Date.now())/1000));
  renderTimer();
  if(remaining<=0)finish();
}
function beep(){
  if(!sound)return;
  try{
    const C=window.AudioContext||window.webkitAudioContext;
    if(!C)return;
    audioContext=audioContext||new C();
    if(audioContext.state==='suspended')audioContext.resume();
    [0,.22,.44].forEach((delay,i)=>{
      const osc=audioContext.createOscillator();
      const gain=audioContext.createGain();
      osc.type='sine';
      osc.frequency.value=[660,880,1046][i];
      gain.gain.setValueAtTime(.001,audioContext.currentTime+delay);
      gain.gain.exponentialRampToValueAtTime(.13,audioContext.currentTime+delay+.025);
      gain.gain.exponentialRampToValueAtTime(.001,audioContext.currentTime+delay+.19);
      osc.connect(gain);gain.connect(audioContext.destination);
      osc.start(audioContext.currentTime+delay);
      osc.stop(audioContext.currentTime+delay+.2);
    });
  }catch(e){}
}
function notify(message){
  beep();
  try{if(navigator.vibrate)navigator.vibrate([180,90,180])}catch(e){}
  if('Notification'in window&&Notification.permission==='granted'){
    try{new Notification('وقتي',{body:message})}catch(e){}
  }
}
function finish(){
  stop();
  if(mode==='work'){
    checkDay();
    stats.sessions++;
    stats.minutes+=settings.work;
    save(KEY.stats,stats);
    cycles++;
    mode=cycles%settings.cycle===0?'long':'short';
    remaining=duration();
    setStatus('عاش! خلصت جلسة مذاكرة كاملة 🎉 خد راحتك.');
    notify('انتهت جلسة المذاكرة. وقت '+modeName(mode)+'.');
  }else{
    mode='work';
    remaining=duration();
    setStatus('خلصت الراحة! ارجع لهدفك 💪');
    notify('انتهت الراحة. وقت التركيز من جديد.');
  }
  renderTimer();renderStats();
}
function reset(){
  stop();remaining=duration();renderTimer();
  setStatus('بدأنا من الأول. مستعد؟');
}
function choose(m){
  pause();
  mode=m;remaining=duration();
  renderTimer();setStatus('تم اختيار '+modeName(m));
}
function applySettings(){
  const s={
    work:Number($('workLen').value),
    short:Number($('shortLen').value),
    long:Number($('longLen').value),
    cycle:Number($('cycleLen').value),
    goal:Number($('goalLen').value)
  };
  if(!Number.isInteger(s.work)||s.work<1||s.work>180||
     !Number.isInteger(s.short)||s.short<1||s.short>60||
     !Number.isInteger(s.long)||s.long<1||s.long>90||
     !Number.isInteger(s.cycle)||s.cycle<2||s.cycle>8||
     !Number.isInteger(s.goal)||s.goal<15||s.goal>1440){
    setStatus('راجع الإعدادات: المذاكرة 1–180، القصيرة 1–60، الطويلة 1–90، الدورات 2–8، والهدف 15–1440.');
    return;
  }
  pause();
  settings=s;save(KEY.settings,settings);
  remaining=duration();
  renderTimer();renderStats();
  setStatus('تم حفظ إعداداتك بنجاح ✓');
}
function renderStats(){
  checkDay();save(KEY.stats,stats);
  $('sessions').textContent=stats.sessions;
  $('minutes').textContent=stats.minutes;
  const done=tasks.filter(t=>t.done).length;
  $('percent').textContent=(tasks.length?Math.round(done/tasks.length*100):0)+'%';
  $('goalText').textContent=stats.minutes+' / '+settings.goal+' دقيقة';
  $('goalBar').style.width=Math.min(100,stats.minutes/settings.goal*100)+'%';
}
function renderTasks(){
  $('taskList').replaceChildren();
  tasks.forEach(task=>{
    const li=document.createElement('li');
    li.className='task'+(task.done?' done':'');
    const cb=document.createElement('input');
    cb.type='checkbox';cb.checked=task.done;
    cb.setAttribute('aria-label','تحديد المهمة كمكتملة');
    cb.addEventListener('change',()=>{
      task.done=cb.checked;save(KEY.tasks,tasks);
      renderTasks();renderStats();
    });
    const name=document.createElement('span');
    name.className='task-name';name.textContent=task.name;
    const del=document.createElement('button');
    del.type='button';del.className='del';del.textContent='✕';
    del.setAttribute('aria-label','حذف '+task.name);
    del.addEventListener('click',()=>{
      tasks=tasks.filter(t=>t.id!==task.id);
      save(KEY.tasks,tasks);renderTasks();renderStats();
    });
    li.append(cb,name,del);$('taskList').append(li);
  });
  $('empty').classList.toggle('hidden',tasks.length>0);
  $('taskCount').textContent=tasks.length+' مهام · '+tasks.filter(t=>t.done).length+' مكتملة';
}
$('startBtn').addEventListener('click',()=>interval!==null?pause():start());
$('resetBtn').addEventListener('click',reset);
$('skipBtn').addEventListener('click',()=>{
  pause();
  mode=mode==='work'?'short':'work';
  remaining=duration();renderTimer();
  setStatus('انتقلت إلى '+modeName(mode));
});
document.querySelectorAll('[data-mode]').forEach(b=>{
  b.addEventListener('click',()=>choose(b.dataset.mode));
});
$('applyBtn').addEventListener('click',applySettings);
$('soundBtn').addEventListener('click',()=>{
  sound=!sound;
  $('soundBtn').textContent=sound?'🔔 الصوت يعمل':'🔕 الصوت مغلق';
  if(sound&&'Notification'in window&&Notification.permission==='default'){
    Notification.requestPermission().catch(()=>{});
  }
  if(sound)beep();
});
$('taskForm').addEventListener('submit',e=>{
  e.preventDefault();
  const name=$('taskInput').value.trim();
  if(!name)return;
  tasks.push({id:Date.now()+Math.random(),name,done:false});
  save(KEY.tasks,tasks);$('taskInput').value='';
  renderTasks();renderStats();$('taskInput').focus();
});
$('clearDone').addEventListener('click',()=>{
  tasks=tasks.filter(t=>!t.done);
  save(KEY.tasks,tasks);renderTasks();renderStats();
});
$('clearStats').addEventListener('click',()=>{
  if(!confirm('هل تريد تصفير إحصائيات اليوم؟'))return;
  stats={date:today(),sessions:0,minutes:0};
  save(KEY.stats,stats);renderStats();
  setStatus('تم تصفير إحصائيات اليوم.');
});
const tips=[
  'ابعد الموبايل عنك، وحدد مهمة واحدة. مش لازم تكون متحمس عشان تبدأ.',
  'بعد كل جلسة، حاول تسترجع اللي ذاكرته من غير ما تبص في الكتاب.',
  'حل الأسئلة بعد المذاكرة بيساعدك تعرف إيه اللي محتاج تراجعه.',
  'قسّم الدرس الكبير لمهام صغيرة تقدر تخلصها واحدة واحدة.',
  'اشرب مياه وخد راحة قصيرة بعيدًا عن الشاشة بين الجلسات.',
  'ابدأ بأصعب سؤال وأنت لسه مركز، وسيب المراجعة الخفيفة لآخر الجلسة.'
];
let tipIndex=0;
$('newTip').addEventListener('click',()=>{
  tipIndex=(tipIndex+1)%tips.length;
  $('tipText').textContent=tips[tipIndex];
});
const stored=read(KEY.settings,null);
if(stored){
  settings={...defaults,...stored};
  $('workLen').value=settings.work;
  $('shortLen').value=settings.short;
  $('longLen').value=settings.long;
  $('cycleLen').value=settings.cycle;
  $('goalLen').value=settings.goal;
}
remaining=duration();
renderTimer();renderTasks();renderStats();

document.addEventListener('visibilitychange',()=>{
  if(!document.hidden&&interval!==null)update();
});
window.addEventListener('pageshow',()=>{
  if(interval!==null)update();
});
})();
</script>
</body>
</html>
